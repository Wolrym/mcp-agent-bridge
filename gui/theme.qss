/*
 * MCP Agent Bridge - dark graphite theme.
 *
 * Colours are written as @name and filled in from gui/widgets/tokens.py
 * when the sheet loads, so painted widgets and this file never drift
 * apart. Three rules keep the file predictable:
 *   1. Only surfaces set a background. Plain containers stay transparent,
 *      so nothing paints a flat slab over a card, the glow or the window
 *      border.
 *   2. Controls catch the light from above: the top border is brighter
 *      than the bottom one.
 *   3. Every interactive variant defines its own disabled look, so a
 *      disabled control dims instead of falling back to Fusion's default.
 */

/* --- base ------------------------------------------------------------ */

QWidget {
    color: @text;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* Frameless windows paint their surface through #windowShell, so the
 * window widget itself stays transparent behind the rounded corners.
 * Native dialogs keep a solid page background, since they have no shell. */
QMainWindow, QDialog {
    background: transparent;
}

QMessageBox, QFileDialog {
    background-color: @shell;
}

QWidget#windowShell {
    background-color: @shell;
    border: 1px solid @edge;
    border-radius: 12px;
}

QWidget#windowShell[maximized="true"] {
    border: none;
    border-radius: 0px;
}

QToolTip {
    background-color: @btn_top;
    color: @text;
    border: 1px solid @btn_edge;
    border-radius: 6px;
    padding: 4px 8px;
}

/* --- window chrome --------------------------------------------------- */

QWidget#titleBar {
    background: transparent;
}

QLabel#titleDot {
    background-color: @faint;
    border-radius: 4px;
}

QLabel#titleText {
    color: @text_2;
    font-size: 12px;
    font-weight: 600;
}

/* --- sidebar --------------------------------------------------------- */

QWidget#sidebar {
    background: transparent;
}

QLabel[variant="sidebarCaption"] {
    color: @faint;
    font-size: 11px;
    font-weight: 600;
    padding-left: 10px;
}

QPushButton#navItem {
    background: transparent;
    color: @text_2;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 10px 7px 36px;
    text-align: left;
    font-size: 13px;
    font-weight: 400;
    min-height: 16px;
}

QPushButton#navItem:hover {
    background-color: @hover;
    color: @text;
}

QPushButton#navItem:checked {
    background-color: @selected;
    border-top-color: @selected_hi;
    color: @text_strong;
}

QFrame#projectChip {
    background: transparent;
    border: 1px solid @line;
    border-top-color: @btn_edge;
    border-radius: 10px;
}

QFrame#projectChip:hover {
    background-color: @hover;
}

QLabel[variant="chipName"] {
    color: @text;
    font-size: 13px;
    font-weight: 600;
}

QLabel[variant="chipPath"] {
    color: @muted;
    font-size: 11px;
}

/* --- typography ------------------------------------------------------ */

QLabel[variant="pageTitle"] {
    font-size: 22px;
    font-weight: 600;
    color: @text_strong;
}

QLabel[variant="pageSubtitle"] {
    font-size: 13px;
    color: @muted;
}

QLabel[variant="groupTitle"] {
    font-size: 13px;
    font-weight: 600;
    color: @text;
}

QLabel[variant="caption"] {
    font-size: 12px;
    color: @muted;
}

QLabel[variant="rowTitle"] {
    font-size: 13px;
    color: @text;
}

QLabel[variant="rowDescription"] {
    font-size: 12px;
    color: @muted;
}

QLabel[variant="rowMono"] {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    color: @text_2;
}

QLabel[variant="title"] {
    font-size: 20px;
    font-weight: 600;
    color: @text_strong;
}

QLabel[variant="subtitle"] {
    font-size: 13px;
    color: @muted;
}

QLabel[variant="cardTitle"] {
    font-size: 14px;
    font-weight: 600;
    color: @text;
}

QLabel[variant="cardDescription"] {
    font-size: 12px;
    color: @muted;
}

QLabel[variant="label"] {
    font-size: 11px;
    font-weight: 600;
    color: @muted;
}

QLabel[variant="step"] {
    font-size: 12px;
    color: @text_2;
}

QLabel[variant="stepNumber"] {
    background-color: @btn_bottom;
    color: @text_2;
    border: 1px solid @btn_edge;
    border-top-color: @btn_hi;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 600;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QLabel[variant="muted"] {
    font-size: 12px;
    color: @muted;
}

QLabel[variant="mono"] {
    font-family: "Cascadia Mono", "Consolas", monospace;
    color: @text_2;
}

/* --- surfaces -------------------------------------------------------- */

QFrame#group, QFrame#card {
    background-color: @surface;
    border: 1px solid @line;
    border-radius: 12px;
}

QFrame#divider {
    background-color: @divider;
    border: none;
    max-height: 1px;
    min-height: 1px;
    margin: 0px 14px;
}

QFrame#separator {
    background-color: @divider;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* --- buttons ---------------------------------------------------------
 * The base rule doubles as "secondary", so an unknown variant can never
 * fall through to an unstyled button.
 */

QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @btn_top, stop:1 @btn_bottom);
    color: @text;
    border: 1px solid @btn_edge;
    border-top-color: @btn_hi;
    border-bottom-color: @btn_lo;
    border-radius: 8px;
    padding: 6px 13px;
    font-size: 12px;
    font-weight: 600;
    min-height: 16px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @btn_top_hover, stop:1 @btn_bottom_hover);
    border-top-color: @btn_hi_hover;
}

QPushButton:pressed {
    background-color: @btn_bottom;
    border-top-color: @btn_edge;
}

QPushButton:disabled {
    background-color: @btn_disabled;
    border-color: @btn_disabled_edge;
    color: @faint;
}

QPushButton[glyph="true"] {
    padding-left: 34px;
    text-align: left;
}

QPushButton[variant="default"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @prim_top, stop:1 @prim_bottom);
    color: @prim_text;
    border: 1px solid @prim_edge;
    border-top-color: @prim_hi;
    border-bottom-color: @prim_lo;
}

QPushButton[variant="default"]:hover {
    background-color: @prim_top;
}

QPushButton[variant="default"]:pressed {
    background-color: @prim_bottom;
    border-top-color: @prim_edge;
}

QPushButton[variant="default"]:disabled {
    background-color: @prim_disabled;
    border-color: @prim_disabled;
    color: @prim_disabled_text;
}

QPushButton[variant="destructive"] {
    color: @danger_text;
}

QPushButton[variant="destructive"]:hover {
    background-color: @danger_hover;
    border-color: @danger_edge;
    border-top-color: @danger_edge;
}

QPushButton[variant="destructive"]:disabled {
    background-color: @btn_disabled;
    border-color: @btn_disabled_edge;
    color: @faint;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: @muted;
}

QPushButton[variant="ghost"]:hover {
    background-color: @hover;
    color: @text;
}

QPushButton[variant="ghost"]:disabled {
    background: transparent;
    color: @faint;
}

/* The master action at the top of the sidebar is a little taller. */
QPushButton#masterAction {
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 13px;
}

/* --- segmented control ------------------------------------------------ */

QFrame#segmented {
    background-color: @seg_bg;
    border: 1px solid @line;
    border-radius: 9px;
}

QPushButton#segment {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px 11px;
    color: @muted;
    font-size: 12px;
    font-weight: 600;
    min-height: 14px;
}

QPushButton#segment:hover {
    color: @text;
}

QPushButton#segment:checked {
    background-color: @seg_sel;
    border-color: @btn_edge;
    border-top-color: @seg_sel_hi;
    color: @text_strong;
}

/* --- badges ---------------------------------------------------------- */

QLabel[badge="neutral"] {
    background-color: @neutral_bg;
    color: @neutral_text;
    border: 1px solid @neutral_edge;
    border-radius: 10px;
    padding: 2px 10px 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[badge="success"] {
    background-color: @success_bg;
    color: @success_text;
    border: 1px solid @success_edge;
    border-radius: 10px;
    padding: 2px 10px 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[badge="warning"] {
    background-color: @warning_bg;
    color: @warning_text;
    border: 1px solid @warning_edge;
    border-radius: 10px;
    padding: 2px 10px 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[badge="danger"] {
    background-color: @danger_bg;
    color: @danger_text;
    border: 1px solid @danger_edge;
    border-radius: 10px;
    padding: 2px 10px 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* Room for the painted status dot; after the tones so it wins. */
QLabel[dot="true"] {
    padding-left: 20px;
}

/* --- inputs ---------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: @input;
    color: @text_2;
    border: 1px solid @input_edge;
    border-top-color: @input_hi;
    border-bottom-color: @input_lo;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: @selection;
    selection-color: @text_strong;
}

/* The one place the accent shows up besides the sidebar: where you type. */
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: @accent_ring;
}

QLineEdit:read-only:focus, QPlainTextEdit:read-only:focus {
    border-color: @input_edge;
    border-top-color: @input_hi;
    border-bottom-color: @input_lo;
}

QLineEdit {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

QLineEdit:disabled {
    color: @faint;
    border-color: @btn_disabled_edge;
}

QPlainTextEdit, QTextEdit {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

QPlainTextEdit#logView {
    background-color: @log;
    color: @text_2;
    border: none;
    border-radius: 12px;
    padding: 10px 12px;
}

/* --- lists ----------------------------------------------------------- */

QListWidget {
    background-color: @input;
    border: 1px solid @input_edge;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 7px 9px;
    border-radius: 6px;
    color: @text_2;
}

QListWidget::item:hover {
    background-color: @hover;
}

QListWidget::item:selected {
    background-color: @selected;
    color: @text_strong;
}

/* --- tabs (older screens) -------------------------------------------- */

QTabWidget::pane {
    background: transparent;
    border: none;
    border-top: 1px solid @divider;
    padding: 12px 2px 0px 0px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: @muted;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 13px;
    margin-right: 4px;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: @text;
}

QTabBar::tab:selected {
    background-color: @seg_sel;
    color: @text_strong;
    border-color: @btn_edge;
    border-top-color: @seg_sel_hi;
}

/* --- scroll areas and bars ------------------------------------------- */

QScrollArea {
    background: transparent;
    border: none;
}

/* A scroll viewport fills itself with the palette colour; left alone it
 * paints a square slab over the rounded corners and the glow. */
QScrollArea > QWidget {
    background: transparent;
}

QStackedWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @btn_edge;
    border-radius: 3px;
    min-height: 28px;
    margin: 2px 3px 2px 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: @btn_hi;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @btn_edge;
    border-radius: 3px;
    min-width: 28px;
    margin: 1px 2px 3px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @btn_hi;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}
