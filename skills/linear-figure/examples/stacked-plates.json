{
  "version": 1,
  "title": "Stacked plates",
  "camera": { "view": "isometric", "padding": 0.14 },
  "parts": [
    { "id": "base", "shape": { "type": "box", "size": [1.5, 0.1, 1.5], "radius": 0.1 } },
    {
      "id": "plate",
      "shape": { "type": "box", "size": [1.1, 0.06, 1.1], "radius": 0.08 },
      "position": [0, 0.18, 0],
      "repeat": { "count": 5, "step": [0, 0.14, 0] },
      "tags": ["stack"]
    }
  ],
  "states": {
    "intro": {
      "parts": { "*": { "draw": 0 }, ".stack": { "offset": [0, -0.12, 0], "opacity": 0 } }
    },
    "rest": { "transition": { "spring": "smooth", "stagger": 0.06, "order": "y" } },
    "hover": {
      "extends": "rest",
      "parts": {
        "plate": { "offset": { "from": [0, 0, 0], "to": [0, 0.24, 0], "ease": "out" } },
        "plate[4]": { "accent": 1 }
      },
      "camera": { "yaw": 8 },
      "transition": { "spring": "morph", "stagger": 0.03, "order": "reverse" }
    }
  },
  "initial": "intro",
  "interaction": { "inView": "rest", "hover": "hover" },
  "pointer": {
    "tilt": 6,
    "fields": [
      {
        "parts": "plate",
        "axis": "y",
        "shape": "bump",
        "width": 0.3,
        "add": { "offset": [0, 0.06, 0] }
      }
    ]
  }
}
